# Copy to .env and fill in. Never commit .env.
#
# Nothing in this repo *requires* .env — the Databricks CLI profile in
# ~/.databrickscfg carries the host and credentials, and the Makefile passes
# --profile on every call. These are here for the two cases the profile
# cannot cover.

# Workspace URL, e.g. https://dbc-a1b2c3d4-e5f6.cloud.databricks.com
# Only read by scripts/auth.sh, to skip the interactive prompt.
DATABRICKS_HOST=

# Only needed if OAuth (`databricks auth login`) does not work on Free Edition.
# Create at: Workspace > Settings > Developer > Access tokens
DATABRICKS_TOKEN=

# SQL warehouse id, used by scripts/run_sql.py.
# The bundle itself resolves the warehouse BY NAME (see databricks.yml), so
# this is only needed if `make sql` picks the wrong one.
# Find at: SQL Warehouses > Serverless Starter Warehouse > Connection details
DATABRICKS_WAREHOUSE_ID=
